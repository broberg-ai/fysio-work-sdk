{
  "openapi": "3.1.0",
  "info": {
    "title": "fysio.work module API (what core calls on every module)",
    "version": "0.1.0",
    "description": "Served by createModule; a module does not implement these by hand. Request bodies are strict (unknown field -> 400), response bodies tolerant (unknown field ignored). Headers: see runtime.json."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "description": "Process is alive. Says nothing about whether the module works — core judges that (§3.11).",
        "responses": {
          "200": { "description": "alive", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } },
          "503": { "description": "draining", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } }
        }
      }
    },
    "/_fysio/gdpr/export": {
      "post": {
        "operationId": "exportPatient",
        "description": "Core asks for everything the module holds about one patient in one organization (§3.10).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PatientRef" } } } },
        "responses": {
          "200": { "description": "export", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PatientExport" } } } }
        }
      }
    },
    "/_fysio/widgets": {
      "post": {
        "operationId": "widgetContent",
        "description": "Core asks for one widget's content on behalf of the user — the ticket is the user's own (F007). A widget id not in the manifest is 404 unknown_widget.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WidgetRequest" } } } },
        "responses": {
          "200": { "description": "content", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WidgetContent" } } } }
        }
      }
    },
    "/_fysio/gdpr/delete": {
      "post": {
        "operationId": "deletePatient",
        "description": "Core asks the module to delete what it holds about one patient in one organization (§3.10).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PatientRef" } } } },
        "responses": {
          "200": { "description": "deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PatientDeleted" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WidgetRequest": {
        "type": "object",
        "required": ["widgetId", "size"],
        "properties": {
          "widgetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$" },
          "size": { "enum": ["third", "half", "full"] }
        }
      },
      "WidgetContent": {
        "type": "object",
        "description": "One widget's content. `content` follows `kind`: stat {value, label, note?} · list {rows: [{text, note?, href?}]} · chart {points: [{label, value}]} · actions {buttons: [{label, href}]} · custom {element, props}.",
        "required": ["widgetId", "kind", "content"],
        "properties": {
          "widgetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$" },
          "kind": { "enum": ["stat", "list", "chart", "actions", "custom"] },
          "content": { "type": "object", "additionalProperties": true },
          "actions": {
            "type": "array",
            "maxItems": 3,
            "description": "Links into the module shown under the widget, relative to the module's own route.",
            "items": {
              "type": "object",
              "required": ["label", "href"],
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                "href": { "type": "string", "pattern": "^/" }
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "enum": ["ok", "draining"] } }
      },
      "PatientRef": {
        "type": "object",
        "required": ["patientId"],
        "properties": { "patientId": { "type": "string", "minLength": 1, "maxLength": 128 } }
      },
      "PatientExport": {
        "type": "object",
        "required": ["patientId", "data"],
        "properties": {
          "patientId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "data": { "type": "object", "additionalProperties": true }
        }
      },
      "PatientDeleted": {
        "type": "object",
        "required": ["patientId", "deleted"],
        "properties": {
          "patientId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "deleted": { "const": true }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "traceId"],
            "properties": {
              "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "message": { "type": "string" },
              "traceId": { "type": "string" },
              "fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
