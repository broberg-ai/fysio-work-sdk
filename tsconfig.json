{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node"
    ],
    "paths": {
      "@fysio-work/sdk": [
        "./src/index.ts"
      ],
      "@fysio-work/sdk/sandbox": [
        "./src/sandbox.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples",
    "scripts",
    "templates",
    "vitest.config.ts"
  ]
}
